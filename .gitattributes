# Keep text identical on Windows/macOS/Linux; do not transform public binaries.
* text=auto
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.php text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.txt text eol=lf
.htaccess text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.pdf binary
*.zip binary
